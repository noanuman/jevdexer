<Window x:Class="Jevdexer.App.TourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Jevdexer.App"
        Title="Welcome to Jevdexer" Width="648" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Icon="/Assets/Jevdexer.ico" ResizeMode="NoResize" ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Sans}" FontSize="14" FontWeight="Medium"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <!-- A big keyboard key, for the shortcut steps. -->
        <DataTemplate x:Key="KeyCaps">
            <ItemsControl ItemsSource="{Binding}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Background}" BorderBrush="{DynamicResource Input}" BorderThickness="1,1,1,3"
                                CornerRadius="8" MinWidth="56" Height="52" Padding="16,0" Margin="5,0">
                            <TextBlock Text="{Binding}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- A result row in the mock search window. -->
        <Style x:Key="MockRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="6,1" />
        </Style>

        <Style x:Key="Illustration" TargetType="Border">
            <Setter Property="Height" Value="232" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource Muted}" />
            <Setter Property="Margin" Value="24,0,24,0" />
        </Style>
    </Window.Resources>

    <Border x:Name="Surface" Style="{StaticResource Surface.Popover}" Margin="24" MouseLeftButtonDown="Surface_MouseLeftButtonDown">
        <StackPanel Background="Transparent">
            <!-- Top: progress and skip -->
            <Grid Margin="24,18,16,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ItemsControl x:Name="Dots" VerticalAlignment="Center" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="6" Width="{Binding Width}" CornerRadius="3" Margin="0,0,5,0" Background="{Binding Brush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="SkipButton" Grid.Column="1" Style="{StaticResource Button.Ghost}" Height="30" Padding="10,0" Click="Skip_Click">
                    <TextBlock Text="Skip tour" FontSize="13" Foreground="{DynamicResource MutedForeground}" />
                </Button>
            </Grid>

            <Grid x:Name="Stage">
                <!-- 1. Welcome -->
                <StackPanel x:Name="Step1">
                    <Border Style="{StaticResource Illustration}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- The mascot, alive: it breathes and blinks. -->
                            <app:Mascot x:Name="WelcomeMascot" Width="112" Height="112" HorizontalAlignment="Center" FollowCursor="True" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                <Border Style="{StaticResource Badge}" Background="{DynamicResource Popover}" Padding="10,4" Margin="4,0"><StackPanel Orientation="Horizontal"><app:Icon Data="{StaticResource Icon.AppWindow}" Size="13" Margin="0,0,6,0" /><TextBlock Text="Apps" FontSize="12.5" /></StackPanel></Border>
                                <Border Style="{StaticResource Badge}" Background="{DynamicResource Popover}" Padding="10,4" Margin="4,0"><StackPanel Orientation="Horizontal"><app:Icon Data="{StaticResource Icon.Folder}" Size="13" Margin="0,0,6,0" /><TextBlock Text="Folders" FontSize="12.5" /></StackPanel></Border>
                                <Border Style="{StaticResource Badge}" Background="{DynamicResource Popover}" Padding="10,4" Margin="4,0"><StackPanel Orientation="Horizontal"><app:Icon Data="{StaticResource Icon.File}" Size="13" Margin="0,0,6,0" /><TextBlock Text="Files" FontSize="12.5" /></StackPanel></Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 2. The shortcut -->
                <StackPanel x:Name="Step2" Visibility="Collapsed">
                    <Border Style="{StaticResource Illustration}">
                        <ContentPresenter x:Name="Keys2" ContentTemplate="{StaticResource KeyCaps}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- 3. Names or descriptions -->
                <StackPanel x:Name="Step3" Visibility="Collapsed">
                    <!-- The screen recording (Assets/Tour/explainer.mp4), looped and muted; the drawn mock
                         below stands in when the file is missing or the PC cannot play it. -->
                    <Border x:Name="VideoFrame" Height="232" Margin="24,0" CornerRadius="10" Background="Black" Visibility="Collapsed" SizeChanged="VideoFrame_SizeChanged">
                        <Grid x:Name="VideoClip">
                            <MediaElement x:Name="Explainer" LoadedBehavior="Manual" UnloadedBehavior="Stop" IsMuted="True" Stretch="UniformToFill"
                                          MediaEnded="Explainer_MediaEnded" MediaFailed="Explainer_MediaFailed" />
                        </Grid>
                    </Border>
                    <Border x:Name="MockSearch" Style="{StaticResource Illustration}" Padding="40,18">
                        <Border Background="{DynamicResource Popover}" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Border}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="14,11">
                                    <app:Icon Data="{StaticResource Icon.Search}" Size="15" Foreground="{DynamicResource MutedForeground}" />
                                    <TextBlock x:Name="MockQuery" Text="edit a video" Margin="10,0,0,0" FontSize="14.5" />
                                    <Border x:Name="Caret" Width="1.5" Height="17" Background="{DynamicResource Foreground}" Margin="2,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Style="{StaticResource Separator}" />
                                <TextBlock Text="Applications" Style="{StaticResource Text.GroupHeading}" Margin="16,8,0,4" />
                                <Border Style="{StaticResource MockRow}" Background="{DynamicResource Accent}">
                                    <StackPanel Orientation="Horizontal"><app:Icon Data="{StaticResource Icon.AppWindow}" Size="16" Margin="0,0,10,0" /><TextBlock Text="CapCut" /><TextBlock Text="  Video editor" Foreground="{DynamicResource MutedForeground}" FontSize="12.5" VerticalAlignment="Center" /></StackPanel>
                                </Border>
                                <Border Style="{StaticResource MockRow}">
                                    <StackPanel Orientation="Horizontal"><app:Icon Data="{StaticResource Icon.AppWindow}" Size="16" Margin="0,0,10,0" /><TextBlock Text="Clipchamp" /><TextBlock Text="  Video editor" Foreground="{DynamicResource MutedForeground}" FontSize="12.5" VerticalAlignment="Center" /></StackPanel>
                                </Border>
                                <Border Style="{StaticResource MockRow}" Margin="6,1,6,8">
                                    <StackPanel Orientation="Horizontal"><app:Icon Data="{StaticResource Icon.AppWindow}" Size="16" Margin="0,0,10,0" /><TextBlock Text="DaVinci Resolve" /><TextBlock Text="  Video editor" Foreground="{DynamicResource MutedForeground}" FontSize="12.5" VerticalAlignment="Center" /></StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Border>
                </StackPanel>

                <!-- 4. Tabs and keys -->
                <StackPanel x:Name="Step4" Visibility="Collapsed">
                    <Border Style="{StaticResource Illustration}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <app:TabsList x:Name="MockTabs" HorizontalAlignment="Center" IsHitTestVisible="False">
                                <RadioButton x:Name="MockAll" Style="{StaticResource Tab}" GroupName="MockTabs" IsChecked="True">
                                    <StackPanel Orientation="Horizontal"><app:Icon Data="{StaticResource Icon.LayoutGrid}" Size="14" Margin="0,0,6,0" /><TextBlock Text="All" /></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="MockApps" Style="{StaticResource Tab}" GroupName="MockTabs">
                                    <StackPanel Orientation="Horizontal"><app:Icon Data="{StaticResource Icon.AppWindow}" Size="14" Margin="0,0,6,0" /><TextBlock Text="Apps" /></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="MockFolders" Style="{StaticResource Tab}" GroupName="MockTabs">
                                    <StackPanel Orientation="Horizontal"><app:Icon Data="{StaticResource Icon.Folder}" Size="14" Margin="0,0,6,0" /><TextBlock Text="Folders" /></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="MockFiles" Style="{StaticResource Tab}" GroupName="MockTabs">
                                    <StackPanel Orientation="Horizontal"><app:Icon Data="{StaticResource Icon.File}" Size="14" Margin="0,0,6,0" /><TextBlock Text="Files" /></StackPanel>
                                </RadioButton>
                            </app:TabsList>
                            <Grid Margin="0,26,0,0" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <Border Style="{StaticResource Kbd}" HorizontalAlignment="Right" Margin="0,0,12,8"><TextBlock Text="Tab" /></Border>
                                <TextBlock Grid.Column="1" Text="Switch between All, Apps, Folders, Files" FontSize="13" Margin="0,0,0,8" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,8">
                                    <Border Style="{StaticResource Kbd}"><app:Icon Data="{StaticResource Icon.ArrowUp}" Size="11" /></Border>
                                    <Border Style="{StaticResource Kbd}" Margin="3,0,0,0"><app:Icon Data="{StaticResource Icon.ArrowDown}" Size="11" /></Border>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Move through results" FontSize="13" Margin="0,0,0,8" />
                                <Border Grid.Row="2" Style="{StaticResource Kbd}" HorizontalAlignment="Right" Margin="0,0,12,8"><app:Icon Data="{StaticResource Icon.CornerDownLeft}" Size="11" /></Border>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Open" FontSize="13" Margin="0,0,0,8" />
                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
                                    <Border Style="{StaticResource Kbd}"><TextBlock Text="Ctrl" /></Border>
                                    <Border Style="{StaticResource Kbd}" Margin="3,0,0,0"><app:Icon Data="{StaticResource Icon.CornerDownLeft}" Size="11" /></Border>
                                </StackPanel>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Show it in its folder" FontSize="13" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 5. Smart search -->
                <StackPanel x:Name="Step5" Visibility="Collapsed">
                    <Border Style="{StaticResource Illustration}">
                        <Border Background="{DynamicResource Popover}" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Border}"
                                Width="460" VerticalAlignment="Center" Padding="18,16">
                            <StackPanel>
                                <!-- The user's own AI Gateway key (optional). -->
                                <app:KeyBox x:Name="TourKey" />
                                <Border Style="{StaticResource Separator}" Margin="0,14" />
                                <Grid x:Name="TourSmartRow">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Smart search" Style="{StaticResource Text.Label}" />
                                            <app:Icon Data="{StaticResource Icon.Sparkles}" Size="14" Foreground="{DynamicResource MutedForeground}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Sends app names and your search, with your key." Style="{StaticResource Text.Muted}" FontSize="13" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton x:Name="TourSmart" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="TourSmart_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Border>
                </StackPanel>

                <!-- 6. Ultra Search -->
                <StackPanel x:Name="Step6" Visibility="Collapsed">
                    <Border Style="{StaticResource Illustration}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="64" Height="80" CornerRadius="6" Background="{DynamicResource Popover}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="6,0">
                                    <StackPanel Margin="10">
                                        <app:Icon Data="{StaticResource Icon.File}" Size="16" HorizontalAlignment="Left" />
                                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Border}" Margin="0,10,0,0" />
                                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Border}" Margin="0,5,8,0" />
                                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Border}" Margin="0,5,4,0" />
                                    </StackPanel>
                                </Border>
                                <Border Width="64" Height="80" CornerRadius="6" Background="{DynamicResource Popover}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="6,0">
                                    <app:Icon Data="{StaticResource Icon.ScanSearch}" Size="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Width="64" Height="80" CornerRadius="6" Background="{DynamicResource Popover}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="6,0">
                                    <Grid Margin="8">
                                        <Border CornerRadius="4" Background="{DynamicResource Muted}" />
                                        <Path Data="M4 44 L20 26 L30 36 L40 22 L52 44 Z" Fill="{DynamicResource MutedForeground}" Opacity="0.5" VerticalAlignment="Bottom" />
                                        <Ellipse Width="9" Height="9" Fill="{DynamicResource MutedForeground}" Opacity="0.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource Popover}" Padding="10,4" Margin="0,18,0,0" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <app:Icon Data="{StaticResource Icon.Lock}" Size="12" Margin="0,0,6,0" />
                                    <TextBlock Text="Read on this PC" FontSize="12.5" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 7. Try it -->
                <StackPanel x:Name="Step7" Visibility="Collapsed">
                    <Border Style="{StaticResource Illustration}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="Keys7" ContentTemplate="{StaticResource KeyCaps}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="WaitingText" Text="Waiting for you to press it..." Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                            <TextBlock FontSize="12.5" Margin="0,22,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource MutedForeground}">
                                <Run Text="Made by" />
                                <Hyperlink NavigateUri="https://x.com/NoaNuman" RequestNavigate="Link_RequestNavigate" Foreground="{DynamicResource Foreground}" TextDecorations="{x:Null}">@NoaNuman</Hyperlink><Run Text=". Say hi on X." />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Words -->
            <StackPanel Margin="32,22,32,0" MinHeight="86">
                <TextBlock x:Name="StepTitle" Style="{StaticResource Text.Title}" FontSize="20" />
                <TextBlock x:Name="StepText" Style="{StaticResource Text.Muted}" FontSize="14.5" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="21" />
            </StackPanel>

            <!-- Buttons -->
            <Grid Margin="24,18,24,22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Style="{StaticResource Button.Ghost}" Click="Back_Click">
                    <StackPanel Orientation="Horizontal">
                        <app:Icon Data="{StaticResource Icon.ArrowLeft}" Size="15" Margin="0,0,8,0" />
                        <TextBlock Text="Back" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="SecondaryButton" Style="{StaticResource Button.Outline}" Margin="0,0,8,0" Click="Secondary_Click" Visibility="Collapsed">
                        <TextBlock x:Name="SecondaryText" />
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource Button}" Click="Next_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="NextText" Text="Next" />
                            <app:Icon x:Name="NextIcon" Data="{StaticResource Icon.ArrowRight}" Size="15" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
