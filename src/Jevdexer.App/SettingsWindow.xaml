<Window x:Class="Jevdexer.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Jevdexer.App"
        Title="Jevdexer settings" Width="808" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Icon="/Assets/Jevdexer.ico" ResizeMode="NoResize" ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Sans}" FontSize="14" FontWeight="Medium"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <!-- One setting: label and one short line on the left, the control on the right. -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,22" />
        </Style>
    </Window.Resources>

    <!-- Drag any empty area to move the window. -->
    <Border x:Name="Surface" Style="{StaticResource Surface.Popover}" Margin="24" MouseLeftButtonDown="Surface_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Border}" Background="Transparent">
                <DockPanel Margin="12,18,12,14">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,16">
                        <app:Mascot Width="30" Height="30" Margin="0,-4,8,0" />
                        <TextBlock Text="Settings" Style="{StaticResource Text.Title}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Style="{StaticResource Button.Ghost}" Height="34" Padding="10,0" HorizontalContentAlignment="Left" Click="Tour_Click">
                            <StackPanel Orientation="Horizontal">
                                <app:Icon Data="{StaticResource Icon.Compass}" Size="15" Margin="0,0,10,0" />
                                <TextBlock Text="Take the tour" FontWeight="Medium" />
                            </StackPanel>
                        </Button>
                        <TextBlock FontSize="12.5" Margin="10,8,0,0" Foreground="{DynamicResource MutedForeground}">
                            <Run Text="Made by" />
                            <Hyperlink NavigateUri="https://x.com/NoaNuman" RequestNavigate="Link_RequestNavigate" Foreground="{DynamicResource Foreground}" TextDecorations="{x:Null}">@NoaNuman</Hyperlink>
                        </TextBlock>
                        <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource MutedForeground}" Margin="10,4,0,0" />
                    </StackPanel>
                    <app:NavList>
                        <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" GroupName="Nav" Tag="general" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><app:Icon Data="{StaticResource Icon.Settings}" Size="15" Margin="0,0,10,0" /><TextBlock Text="General" /></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSmart" Style="{StaticResource NavItem}" GroupName="Nav" Tag="smart" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><app:Icon Data="{StaticResource Icon.Sparkles}" Size="15" Margin="0,0,10,0" /><TextBlock Text="Smart search" /></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavUltra" Style="{StaticResource NavItem}" GroupName="Nav" Tag="ultra" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><app:Icon Data="{StaticResource Icon.ScanSearch}" Size="15" Margin="0,0,10,0" /><TextBlock Text="Ultra Search" /></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavPrivacy" Style="{StaticResource NavItem}" GroupName="Nav" Tag="privacy" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><app:Icon Data="{StaticResource Icon.ShieldCheck}" Size="15" Margin="0,0,10,0" /><TextBlock Text="Privacy &amp; data" /></StackPanel>
                        </RadioButton>
                    </app:NavList>
                </DockPanel>
            </Border>

            <!-- Page -->
            <DockPanel Grid.Column="1">
                <Grid DockPanel.Dock="Top" Margin="28,18,16,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Style="{StaticResource Text.Title}" FontSize="18" />
                        <TextBlock x:Name="PageSubtitle" Style="{StaticResource Text.Muted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource Button.Outline}" Height="32" Padding="12,0" Click="Search_Click" ToolTip="Close settings and open search">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Back to search" VerticalAlignment="Center" FontSize="13" />
                                <app:Icon Data="{StaticResource Icon.ArrowLeft}" Size="14" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Icon}" Margin="8,2,0,0" Click="Close_Click" ToolTip="Close (Esc)">
                            <app:Icon Data="{StaticResource Icon.X}" Size="16" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <Grid Margin="28,4,28,20">
                        <!-- General -->
                        <StackPanel x:Name="PageGeneral">
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Shortcut" Style="{StaticResource Text.Label}" />
                                    <TextBlock x:Name="ShortcutHelp" Text="Opens search anywhere. Click to change." Style="{StaticResource Text.Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ShortcutError" FontSize="13" Foreground="{DynamicResource Destructive}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                                </StackPanel>
                                <Button x:Name="ShortcutButton" Grid.Column="1" Style="{StaticResource Button.Outline}" Padding="10,0" MinWidth="150" Click="Shortcut_Click" VerticalAlignment="Center">
                                    <Grid>
                                        <ContentPresenter x:Name="ShortcutKeys" ContentTemplate="{StaticResource KbdKeys}" />
                                        <TextBlock x:Name="ShortcutRecording" Text="Press keys..." FontWeight="Medium" Foreground="{DynamicResource MutedForeground}" Visibility="Collapsed" />
                                    </Grid>
                                </Button>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Theme" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="Follow Windows, or pick one." Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                                <app:TabsList Grid.Column="1" VerticalAlignment="Center">
                                    <RadioButton x:Name="ThemeSystem" Style="{StaticResource Tab}" GroupName="Theme" Checked="Theme_Checked" Tag="system">
                                        <StackPanel Orientation="Horizontal"><app:Icon Data="{StaticResource Icon.Monitor}" Size="14" Margin="0,0,6,0" /><TextBlock Text="System" /></StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="ThemeLight" Style="{StaticResource Tab}" GroupName="Theme" Checked="Theme_Checked" Tag="light">
                                        <StackPanel Orientation="Horizontal"><app:Icon Data="{StaticResource Icon.Sun}" Size="14" Margin="0,0,6,0" /><TextBlock Text="Light" /></StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="ThemeDark" Style="{StaticResource Tab}" GroupName="Theme" Checked="Theme_Checked" Tag="dark">
                                        <StackPanel Orientation="Horizontal"><app:Icon Data="{StaticResource Icon.Moon}" Size="14" Margin="0,0,6,0" /><TextBlock Text="Dark" /></StackPanel>
                                    </RadioButton>
                                </app:TabsList>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Open at sign-in" Style="{StaticResource Text.Label}" />
                                    <TextBlock x:Name="StartupHelp" Text="So the shortcut always works." Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="StartupSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Startup_Click" />
                            </Grid>
                        </StackPanel>

                        <!-- Smart search -->
                        <StackPanel x:Name="PageSmart" Visibility="Collapsed">
                            <!-- The user's own key: Jevdexer has no server. -->
                            <StackPanel Margin="0,0,0,22">
                                <TextBlock Text="Your AI Gateway key" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="Smart search runs on Jev through your own Vercel account." Style="{StaticResource Text.Muted}" Margin="0,2,0,10" TextWrapping="Wrap" />
                                <app:KeyBox x:Name="GatewayKeyBox" />
                            </StackPanel>
                            <Grid Style="{StaticResource Row}" x:Name="SmartRow">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Smart search" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="Understands searches like &quot;edit a video&quot;." Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="SmartSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Smart_Click" />
                            </Grid>
                            <Grid Style="{StaticResource Row}" x:Name="SmartFoldersRow">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Also for folders" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="Like &quot;tax papers from 2023&quot;. Sends short folder summaries." Style="{StaticResource Text.Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleButton x:Name="SmartFoldersSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="SmartFolders_Click" />
                            </Grid>

                            <!-- What goes online, in one place -->
                            <Border CornerRadius="8" Background="{DynamicResource Muted}" Padding="14,12" Margin="0,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <app:Icon Data="{StaticResource Icon.ShieldCheck}" Size="15" Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                    <TextBlock x:Name="SmartPrivacy" Grid.Column="1" FontSize="13" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Ultra Search -->
                        <app:UltraPage x:Name="PageUltra" Visibility="Collapsed" />

                        <!-- Privacy & data -->
                        <StackPanel x:Name="PagePrivacy" Visibility="Collapsed">
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Search history" Style="{StaticResource Text.Label}" />
                                    <TextBlock x:Name="HistorySummary" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button x:Name="ClearHistoryButton" Grid.Column="1" Style="{StaticResource Button.Outline}" Height="32" Padding="12,0" Click="ClearHistory_Click" VerticalAlignment="Center">
                                    <TextBlock Text="Clear" FontSize="13" />
                                </Button>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Ultra Search data" Style="{StaticResource Text.Label}" />
                                    <TextBlock x:Name="UltraSummary" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button x:Name="WipeButton" Grid.Column="1" Style="{StaticResource Button.Outline}" Height="32" Padding="12,0" Click="Wipe_Click" VerticalAlignment="Center">
                                    <TextBlock x:Name="WipeText" Text="Wipe" FontSize="13" Foreground="{DynamicResource Destructive}" />
                                </Button>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Index" Style="{StaticResource Text.Label}" />
                                    <TextBlock x:Name="IndexSummary" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button x:Name="ReindexButton" Grid.Column="1" Style="{StaticResource Button.Outline}" Height="32" Padding="12,0" Click="Reindex_Click" VerticalAlignment="Center">
                                    <TextBlock x:Name="ReindexText" Text="Re-index" FontSize="13" />
                                </Button>
                            </Grid>
                            <Border CornerRadius="8" Background="{DynamicResource Muted}" Padding="14,12" Margin="0,4,0,0">
                                <DockPanel>
                                    <app:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Lock}" Size="15" Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                    <TextBlock FontSize="13" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap"
                                               Text="Everything Jevdexer keeps is on this PC, encrypted for your Windows account. Uninstalling removes it all." />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>
