<Window x:Class="Jevdexer.App.TrayMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Jevdexer.App"
        Title="Jevdexer menu" Width="264" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource Sans}" FontSize="14" FontWeight="Medium"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <!-- Dropdown menu -->
    <Border x:Name="Surface" Style="{StaticResource Surface.Popover}" CornerRadius="8" Margin="16" Padding="4">
        <StackPanel>
            <TextBlock Text="Jevdexer" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Foreground}" Margin="8,6,8,2" />
            <TextBlock x:Name="Summary" FontSize="12" Foreground="{DynamicResource MutedForeground}" Margin="8,0,8,6" />
            <Border Style="{StaticResource Separator}" Margin="-4,2" />

            <Button Style="{StaticResource Button.MenuItem}" Click="Search_Click">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <app:Icon Data="{StaticResource Icon.Search}" Size="16" Foreground="{DynamicResource MutedForeground}" />
                        <TextBlock Text="Search" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ContentPresenter x:Name="SearchKeys" ContentTemplate="{StaticResource KbdKeys}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <Button Style="{StaticResource Button.MenuItem}" Click="Settings_Click">
                <StackPanel Orientation="Horizontal">
                    <app:Icon Data="{StaticResource Icon.Settings}" Size="16" Foreground="{DynamicResource MutedForeground}" />
                    <TextBlock Text="Settings" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="Reindex" Style="{StaticResource Button.MenuItem}" Click="Reindex_Click">
                <StackPanel Orientation="Horizontal">
                    <app:Icon x:Name="ReindexIcon" Data="{StaticResource Icon.RefreshCw}" Size="16" Foreground="{DynamicResource MutedForeground}" />
                    <TextBlock x:Name="ReindexText" Text="Re-index apps" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Border Style="{StaticResource Separator}" Margin="-4,4" />
            <Button Style="{StaticResource Button.MenuItem}" Click="Quit_Click">
                <StackPanel Orientation="Horizontal">
                    <app:Icon Data="{StaticResource Icon.Power}" Size="16" Foreground="{DynamicResource MutedForeground}" />
                    <TextBlock Text="Quit Jevdexer" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
